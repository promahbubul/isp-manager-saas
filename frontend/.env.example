NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME=ISP ERP
# Business details shown on Terms / Privacy / Refund / Contact pages (needed for SSLCommerz approval).
# These are also the built-in defaults (frontend/lib/site.js); set them only to override.
NEXT_PUBLIC_LEGAL_NAME=Beauty Software Ltd.
NEXT_PUBLIC_SUPPORT_EMAIL=mahbublalam500@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=01623361555
NEXT_PUBLIC_OFFICE_ADDRESS="House #06, Avenue #03, Road #L-14, Block #C, Section #11, Pallabi, Dhaka"
NEXT_PUBLIC_TRADE_LICENSE=

# Optional: serve each ISP's customer portal on <slug>.<root domain> (needs wildcard DNS + TLS)
NEXT_PUBLIC_ROOT_DOMAIN=
# Hosts that belong to the platform itself (comma separated). Any other host is looked up as an ISP's custom domain.
NEXT_PUBLIC_APP_HOSTS=localhost,127.0.0.1

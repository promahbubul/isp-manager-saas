{
  "name": "isp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "test": "vitest run",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "start:worker": "node dist/worker.js",
    "seed:prod": "node dist/scripts/seed.js",
    "db:indexes": "ts-node-dev --transpile-only src/scripts/syncIndexes.ts",
    "db:indexes:prod": "node dist/scripts/syncIndexes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.2",
    "multer": "^2.5.0",
    "net-snmp": "^3.29.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "stripe": "^23.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  },
  "engines": {
    "node": ">=22"
  }
}
